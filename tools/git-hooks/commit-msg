#!/bin/sh
# NpuEmbeddings -- strip agent session links from commit messages.
# SPDX-License-Identifier: Apache-2.0
#
# WHY THIS IS A HOOK AND NOT A NOTE
#
# `Claude-Session: https://claude.ai/code/session_...` is appended by the
# agent harness's own commit template, not by anything in this repository, so
# no amount of prose here changes what the next session does by default. It
# had reached SEVEN commits of the PUBLIC repository before anyone looked --
# a URL that resolves for exactly one person, published to everyone else.
# tasks/0143 removed them from the history; this is what stops them coming
# back.
#
# `Co-Authored-By:` is deliberately KEPT. Attribution is honest and useful;
# a private session URL is neither.
#
# Install (both repositories -- repo/ is the public one and lives inside this
# working tree, so the relative path resolves from either root):
#   git config core.hooksPath tools/git-hooks
#   git -C repo config core.hooksPath ../tools/git-hooks

msg="$1"
[ -f "$msg" ] || exit 0

if grep -q '^Claude-Session: https://claude\.ai/code/session_' "$msg"; then
    tmp="$msg.stripped"
    grep -v '^Claude-Session: https://claude\.ai/code/session_' "$msg" > "$tmp"
    mv "$tmp" "$msg"
    echo "commit-msg: dropped a Claude-Session trailer (tools/git-hooks/commit-msg)" >&2
fi

exit 0
