*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

.idea/
OthersResarch/

# C++ runtime build output and exported designs. The xclbins and instruction
# streams are build artifacts regenerated by:
#   python tools\export_xclbin.py
#   python tools\export_validation.py
runtime/build/
# Standalone build dir for the EmbeddingGemma tokenizer test CLI
# (tasks/0061), compiled by hand with cl.exe -- not part of the CMake
# npuembed target, has no XRT dependency, regenerate per that task's TASK.md.
runtime/build_gemma_tok/
# Standalone build dir for the EmbeddingGemma kernel test CLI (tasks/0063),
# same reasoning as build_gemma_tok/ above -- also holds the generated
# test-vector binary (tools/dump_gemma_kernel_vectors.py), itself derived
# from the sha256-pinned checkpoint, so it stays out of git the same way
# models/** does.
runtime/build_gemma_kernels/
# Standalone build dir for the EmbeddingGemma CPU-encode test CLI
# (tasks/0064), same reasoning as build_gemma_tok/ and build_gemma_kernels/
# above -- also holds ad hoc test corpora and output vectors used only for
# fast local iteration; the ones that matter are copied into the task folder.
runtime/build_gemma_encode/
# EVERY exported design set, however it is suffixed: the plain one, the width
# sweep of tasks/0024 (artifacts1/2/8), the batch sweep of tasks/0025
# (artifacts_b16*) and the minimal-design control (artifacts_pass). A narrower
# pattern, artifacts[0-9]*/, already let artifacts_b16* through once.
#   python tools\export_xclbin.py --cols N --elt-cols M --batch B --out runtime\artifactsX
#   python experiments\m7-switch-cost\build_passthrough.py
runtime/artifacts*/

# Release staging (tools/make_release.ps1)
dist/

# The public subset, assembled by tools/sync_public_repo.py. It is a BUILD
# OUTPUT of this repository and has its own git history; committing it here
# would duplicate every file.
repo/

# External repos cloned for reference reading only (tasks/0044). Not ours,
# not vendored, not redistributed -- read for architecture and ideas, exactly
# like ../FastFlowLM. Re-clone with tools noted in tasks/0044/TASK.md.
externalrepos/
