# Python reference environment (M3) -- regenerate with:
#   & "C:\Users\vegar\.conda\envs\iron\python.exe" -m venv --system-site-packages .venv-ref
.venv-ref/
__pycache__/
*.pyc

# Parsed Perfetto traces (~100 MB) are pure derivatives of the raw trace.txt +
# the physical MLIR, both of which ARE committed. Regenerate byte-identically:
#   python experiments\m2-bf16-gemm\regen_trace_json.py
# Verified with --check: all 8 single-core tags match by sha256.
# The whole-array runs (trace_wa*c_*.json) did not copy their physical MLIR, so
# they are NOT regenerable and are committed -- hence the negation below.
experiments/*/artifacts/trace_*.json
!experiments/*/artifacts/trace_wa*.json

# Upstream checkpoints (91 MB for MiniLM). Refetched and re-verified with:
#   & .\.venv-ref\Scripts\python.exe reference\fetch_model.py
# CHECKPOINT.json is committed -- it pins the sha256 the goldens were made
# against, so a swapped checkpoint fails loudly instead of silently.
# (Ignore the CONTENTS, not the directory -- git will not descend into an
# excluded directory, so `models/` alone would hide CHECKPOINT.json too.)
models/**
!models/
!models/*/
!models/*/CHECKPOINT.json

# Full intermediate tap dump (~54 MB): a deterministic, CPU-only derivative of
# the pinned checkpoint. The committed *_boundary.safetensors is the contract.
#   & .\.venv-ref\Scripts\python.exe reference\make_goldens.py --taps
reference/goldens/*_taps.safetensors

# Same idea, EmbeddingGemma-300M spike (tasks/0055) -- ~382 MB, regenerate:
#   & .\.venv-ref\Scripts\python.exe reference\make_goldens_gemma.py --taps
reference/goldens_gemma/*_taps.safetensors

# Same idea, nomic-embed-text-v1.5 (tasks/0069) -- regenerate:
#   & .\.venv-ref\Scripts\python.exe reference\make_goldens_nomic.py --taps
reference/goldens_nomic/*_taps.safetensors

# Exported ONNX graphs -- 90-133 MB each, and a deterministic derivative of a
# sha256-pinned checkpoint, exactly like the taps goldens above.
# bench_cpu_ort.py regenerates them on demand and caches them here.
experiments/m8-npu-vs-cpu/artifacts/onnx/

# Packed runtime weights (68.8 MB): a deterministic derivative of the pinned
# checkpoint. Repack and re-verify with:
#   & "C:\Users\vegar\.conda\envs\iron\python.exe" tools\pack_npue.py
#   & "C:\Users\vegar\.conda\envs\iron\python.exe" tools\verify_npue.py
*.npue

